<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_05_access_check" targetNamespace="http://bpmn.io/schema/bpmn" exporter="sa-practice-task-2" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_05_access_check">
    <bpmn:participant id="P_Reg" name="Единый реестр КСР (ФСА)" />
    <bpmn:participant id="P_Sys" name="Платформа туроператора" processRef="Proc_P_Sys" />
    <bpmn:messageFlow id="MF_18" name="Запрос статуса" sourceRef="T2" targetRef="P_Reg" />
    <bpmn:messageFlow id="MF_19" name="Статус записи" sourceRef="P_Reg" targetRef="CT" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_P_Sys" name="Платформа туроператора" isExecutable="false">
      <bpmn:startEvent id="S" name="Нужно проверить допуск объекта">
        <bpmn:outgoing>SF_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:businessRuleTask id="T1" name="Проверить статус договора с отелем">
        <bpmn:incoming>SF_1</bpmn:incoming>
        <bpmn:outgoing>SF_2</bpmn:outgoing>
      </bpmn:businessRuleTask>
      <bpmn:exclusiveGateway id="G1" name="Договор действует?">
        <bpmn:incoming>SF_2</bpmn:incoming>
        <bpmn:outgoing>SF_3</bpmn:outgoing>
        <bpmn:outgoing>SF_4</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="E1" name="Допуска нет: договор не действует">
        <bpmn:incoming>SF_3</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sendTask id="T2" name="Запросить статус записи объекта в реестре КСР">
        <bpmn:incoming>SF_4</bpmn:incoming>
        <bpmn:outgoing>SF_5</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:boundaryEvent id="B" name="Реестр недоступен (EXC-5)" attachedToRef="T2" cancelActivity="true">
        <bpmn:outgoing>SF_9</bpmn:outgoing>
        <bpmn:errorEventDefinition id="B_eed" />
      </bpmn:boundaryEvent>
      <bpmn:intermediateCatchEvent id="CT" name="Статус записи получен">
        <bpmn:incoming>SF_5</bpmn:incoming>
        <bpmn:outgoing>SF_6</bpmn:outgoing>
        <bpmn:messageEventDefinition id="CT_med" messageRef="Msg_CT" />
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="G2" name="Статус записи «Действует»?">
        <bpmn:incoming>SF_6</bpmn:incoming>
        <bpmn:outgoing>SF_7</bpmn:outgoing>
        <bpmn:outgoing>SF_8</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="E2" name="Допуск есть">
        <bpmn:incoming>SF_7</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="E3" name="Допуска нет: запись не «Действует»">
        <bpmn:incoming>SF_8</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:serviceTask id="T3" name="Взять последний статус из кэша и определить его возраст">
        <bpmn:incoming>SF_9</bpmn:incoming>
        <bpmn:outgoing>SF_10</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="G3" name="Кэш не старше 24 ч?">
        <bpmn:incoming>SF_10</bpmn:incoming>
        <bpmn:outgoing>SF_11</bpmn:outgoing>
        <bpmn:outgoing>SF_14</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="G5" name="Статус в кэше «Действует»?">
        <bpmn:incoming>SF_11</bpmn:incoming>
        <bpmn:outgoing>SF_12</bpmn:outgoing>
        <bpmn:outgoing>SF_13</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="E4" name="Допуск есть">
        <bpmn:incoming>SF_12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="E5" name="Допуска нет">
        <bpmn:incoming>SF_13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="G4" name="Объект уже был допущен ранее?">
        <bpmn:incoming>SF_14</bpmn:incoming>
        <bpmn:outgoing>SF_15</bpmn:outgoing>
        <bpmn:outgoing>SF_17</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sendTask id="T4" name="Предупредить менеджера ТО: данные реестра устарели">
        <bpmn:incoming>SF_15</bpmn:incoming>
        <bpmn:outgoing>SF_16</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:endEvent id="E6" name="Допуск есть (с предупреждением)">
        <bpmn:incoming>SF_16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="E7" name="Допуска нет: данные реестра устарели">
        <bpmn:incoming>SF_17</bpmn:incoming>
      </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_1" name="" sourceRef="S" targetRef="T1" />
    <bpmn:sequenceFlow id="SF_2" name="" sourceRef="T1" targetRef="G1" />
    <bpmn:sequenceFlow id="SF_3" name="нет" sourceRef="G1" targetRef="E1" />
    <bpmn:sequenceFlow id="SF_4" name="да" sourceRef="G1" targetRef="T2" />
    <bpmn:sequenceFlow id="SF_5" name="" sourceRef="T2" targetRef="CT" />
    <bpmn:sequenceFlow id="SF_6" name="" sourceRef="CT" targetRef="G2" />
    <bpmn:sequenceFlow id="SF_7" name="да" sourceRef="G2" targetRef="E2" />
    <bpmn:sequenceFlow id="SF_8" name="нет" sourceRef="G2" targetRef="E3" />
    <bpmn:sequenceFlow id="SF_9" name="" sourceRef="B" targetRef="T3" />
    <bpmn:sequenceFlow id="SF_10" name="" sourceRef="T3" targetRef="G3" />
    <bpmn:sequenceFlow id="SF_11" name="да" sourceRef="G3" targetRef="G5" />
    <bpmn:sequenceFlow id="SF_12" name="да" sourceRef="G5" targetRef="E4" />
    <bpmn:sequenceFlow id="SF_13" name="нет" sourceRef="G5" targetRef="E5" />
    <bpmn:sequenceFlow id="SF_14" name="нет" sourceRef="G3" targetRef="G4" />
    <bpmn:sequenceFlow id="SF_15" name="да" sourceRef="G4" targetRef="T4" />
    <bpmn:sequenceFlow id="SF_16" name="" sourceRef="T4" targetRef="E6" />
    <bpmn:sequenceFlow id="SF_17" name="нет" sourceRef="G4" targetRef="E7" />
    <bpmn:textAnnotation id="N1"><bpmn:text>BR-01: допуск = действующий договор + запись в Едином реестре КСР со статусом «Действует». При недоступности реестра — кэш не старше 24 ч (EXC-5): новые объекты не допускаются, уже допущенные работают с предупреждением менеджеру.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="N2"><bpmn:text>Результат «Допуска нет» ведёт к блокировке редактирования и stop-sale по всем каналам (EXC-3, схема 1).</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmn:message id="Msg_CT" name="Статус записи" />
  <bpmndi:BPMNDiagram id="Diagram_05_access_check">
    <bpmndi:BPMNPlane id="Plane_05_access_check" bpmnElement="Collab_05_access_check">
