<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_01_main_process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="sa-practice-task-2" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_01_main_process">
    <bpmn:participant id="P_Hotel" name="Отель-партнёр (Отельер)" processRef="Proc_P_Hotel" />
    <bpmn:participant id="P_TO" name="Туроператор" processRef="Proc_P_TO" />
    <bpmn:messageFlow id="MF_49" name="" sourceRef="H1" targetRef="P0" />
    <bpmn:messageFlow id="MF_50" name="" sourceRef="PB" targetRef="HCB" />
    <bpmn:messageFlow id="MF_51" name="" sourceRef="P3" targetRef="HCA" />
    <bpmn:messageFlow id="MF_52" name="" sourceRef="H5" targetRef="Pc0" />
    <bpmn:messageFlow id="MF_53" name="" sourceRef="PE" targetRef="C1" />
    <bpmn:messageFlow id="MF_54" name="" sourceRef="PQE" targetRef="C2" />
    <bpmn:messageFlow id="MF_55" name="" sourceRef="PRE" targetRef="C3" />
    <bpmn:messageFlow id="MF_56" name="" sourceRef="P12" targetRef="C4" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_P_Hotel" name="Отель-партнёр (Отельер)" isExecutable="false">
      <bpmn:startEvent id="H0" name="Нужно изменить квоты или тарифы">
        <bpmn:outgoing>SF_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sendTask id="H1" name="1. Войти в экстранет (SSO + 2FA), выбрать объект">
        <bpmn:incoming>SF_1</bpmn:incoming>
        <bpmn:outgoing>SF_2</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:eventBasedGateway id="HG" name="" eventGatewayType="Exclusive">
        <bpmn:incoming>SF_2</bpmn:incoming>
        <bpmn:outgoing>SF_3</bpmn:outgoing>
        <bpmn:outgoing>SF_4</bpmn:outgoing>
      </bpmn:eventBasedGateway>
      <bpmn:intermediateCatchEvent id="HCB" name="Редактирование заблокировано (EXC-3)">
        <bpmn:incoming>SF_4</bpmn:incoming>
        <bpmn:outgoing>SF_5</bpmn:outgoing>
        <bpmn:messageEventDefinition id="HCB_med" messageRef="Msg_HCB" />
      </bpmn:intermediateCatchEvent>
      <bpmn:endEvent id="HEB" name="Работа невозможна: допуска нет">
        <bpmn:incoming>SF_5</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:intermediateCatchEvent id="HCA" name="Календарь квот и тарифов получен">
        <bpmn:incoming>SF_3</bpmn:incoming>
        <bpmn:outgoing>SF_6</bpmn:outgoing>
        <bpmn:messageEventDefinition id="HCA_med" messageRef="Msg_HCA" />
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="H3" name="Что нужно сделать?">
        <bpmn:incoming>SF_6</bpmn:incoming>
        <bpmn:outgoing>SF_7</bpmn:outgoing>
        <bpmn:outgoing>SF_8</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:callActivity id="HA" name="ALT-1. Экстренное закрытие продаж (схема 2)" calledElement="Proc_stop_sale">
        <bpmn:incoming>SF_8</bpmn:incoming>
        <bpmn:outgoing>SF_9</bpmn:outgoing>
      </bpmn:callActivity>
      <bpmn:endEvent id="HAE" name="Продажи закрыты">
        <bpmn:incoming>SF_9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:userTask id="H4" name="4–5. Задать квоту и тарифный план">
        <bpmn:incoming>SF_7</bpmn:incoming>
        <bpmn:incoming>SF_18</bpmn:incoming>
        <bpmn:outgoing>SF_10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sendTask id="H5" name="6. Нажать «Сохранить и опубликовать»">
        <bpmn:incoming>SF_10</bpmn:incoming>
        <bpmn:outgoing>SF_11</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:eventBasedGateway id="HG2" name="" eventGatewayType="Exclusive">
        <bpmn:incoming>SF_11</bpmn:incoming>
        <bpmn:outgoing>SF_12</bpmn:outgoing>
        <bpmn:outgoing>SF_13</bpmn:outgoing>
        <bpmn:outgoing>SF_14</bpmn:outgoing>
        <bpmn:outgoing>SF_15</bpmn:outgoing>
      </bpmn:eventBasedGateway>
      <bpmn:intermediateCatchEvent id="C1" name="Ошибки валидации или конфликт версий">
        <bpmn:incoming>SF_12</bpmn:incoming>
        <bpmn:outgoing>SF_16</bpmn:outgoing>
        <bpmn:messageEventDefinition id="C1_med" messageRef="Msg_C1" />
      </bpmn:intermediateCatchEvent>
      <bpmn:intermediateCatchEvent id="C2" name="Требуются уточнения">
        <bpmn:incoming>SF_13</bpmn:incoming>
        <bpmn:outgoing>SF_17</bpmn:outgoing>
        <bpmn:messageEventDefinition id="C2_med" messageRef="Msg_C2" />
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="J1" name="">
        <bpmn:incoming>SF_16</bpmn:incoming>
        <bpmn:incoming>SF_17</bpmn:incoming>
        <bpmn:outgoing>SF_18</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:intermediateCatchEvent id="C3" name="Заявка отклонена">
        <bpmn:incoming>SF_14</bpmn:incoming>
        <bpmn:outgoing>SF_19</bpmn:outgoing>
        <bpmn:messageEventDefinition id="C3_med" messageRef="Msg_C3" />
      </bpmn:intermediateCatchEvent>
      <bpmn:endEvent id="EC3" name="Заявка закрыта (можно подать новую)">
        <bpmn:incoming>SF_19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:intermediateCatchEvent id="C4" name="Результат публикации получен">
        <bpmn:incoming>SF_15</bpmn:incoming>
        <bpmn:outgoing>SF_20</bpmn:outgoing>
        <bpmn:messageEventDefinition id="C4_med" messageRef="Msg_C4" />
      </bpmn:intermediateCatchEvent>
      <bpmn:endEvent id="EC4" name="Квоты и тарифы опубликованы">
        <bpmn:incoming>SF_20</bpmn:incoming>
      </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_1" name="" sourceRef="H0" targetRef="H1" />
    <bpmn:sequenceFlow id="SF_2" name="" sourceRef="H1" targetRef="HG" />
    <bpmn:sequenceFlow id="SF_3" name="" sourceRef="HG" targetRef="HCA" />
    <bpmn:sequenceFlow id="SF_4" name="" sourceRef="HG" targetRef="HCB" />
    <bpmn:sequenceFlow id="SF_5" name="" sourceRef="HCB" targetRef="HEB" />
    <bpmn:sequenceFlow id="SF_6" name="" sourceRef="HCA" targetRef="H3" />
    <bpmn:sequenceFlow id="SF_7" name="Изменить" sourceRef="H3" targetRef="H4" />
    <bpmn:sequenceFlow id="SF_8" name="Закрыть продажи" sourceRef="H3" targetRef="HA" />
    <bpmn:sequenceFlow id="SF_9" name="" sourceRef="HA" targetRef="HAE" />
    <bpmn:sequenceFlow id="SF_10" name="" sourceRef="H4" targetRef="H5" />
    <bpmn:sequenceFlow id="SF_11" name="" sourceRef="H5" targetRef="HG2" />
    <bpmn:sequenceFlow id="SF_12" name="" sourceRef="HG2" targetRef="C1" />
    <bpmn:sequenceFlow id="SF_13" name="" sourceRef="HG2" targetRef="C2" />
    <bpmn:sequenceFlow id="SF_14" name="" sourceRef="HG2" targetRef="C3" />
    <bpmn:sequenceFlow id="SF_15" name="" sourceRef="HG2" targetRef="C4" />
    <bpmn:sequenceFlow id="SF_16" name="" sourceRef="C1" targetRef="J1" />
    <bpmn:sequenceFlow id="SF_17" name="" sourceRef="C2" targetRef="J1" />
    <bpmn:sequenceFlow id="SF_18" name="" sourceRef="J1" targetRef="H4" />
    <bpmn:sequenceFlow id="SF_19" name="" sourceRef="C3" targetRef="EC3" />
    <bpmn:sequenceFlow id="SF_20" name="" sourceRef="C4" targetRef="EC4" />
  </bpmn:process>
  <bpmn:process id="Proc_P_TO" name="Туроператор" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P_TO">
      <bpmn:lane id="L_Mgr" name="Менеджер ТО">
        <bpmn:flowNodeRef>M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CQ</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CR</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Sys" name="Платформа (система)">
        <bpmn:flowNodeRef>P0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CA2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PB</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PBE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Pc0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Pc1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P9a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CA14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PSE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PRE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PQE</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
      <bpmn:startEvent id="P0" name="Получен запрос на вход">
        <bpmn:outgoing>SF_21</bpmn:outgoing>
        <bpmn:messageEventDefinition id="P0_med" messageRef="Msg_P0" />
      </bpmn:startEvent>
      <bpmn:callActivity id="CA2" name="2. Проверка допуска объекта (схема 5)" calledElement="Proc_access_check">
        <bpmn:incoming>SF_21</bpmn:incoming>
        <bpmn:outgoing>SF_22</bpmn:outgoing>
      </bpmn:callActivity>
      <bpmn:exclusiveGateway id="G1" name="Объект допущен к продажам?">
        <bpmn:incoming>SF_22</bpmn:incoming>
        <bpmn:outgoing>SF_23</bpmn:outgoing>
        <bpmn:outgoing>SF_25</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sendTask id="PB" name="EXC-3. Заблокировать редактирование, закрыть продажи, создать задачу менеджеру">
        <bpmn:incoming>SF_23</bpmn:incoming>
        <bpmn:outgoing>SF_24</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:endEvent id="PBE" name="">
        <bpmn:incoming>SF_24</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sendTask id="P3" name="3. Показать календарь квот и тарифных планов">
        <bpmn:incoming>SF_25</bpmn:incoming>
        <bpmn:outgoing>SF_26</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:endEvent id="E1" name="Календарь показан">
        <bpmn:incoming>SF_26</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:startEvent id="Pc0" name="Получена заявка на изменение">
        <bpmn:outgoing>SF_27</bpmn:outgoing>
        <bpmn:messageEventDefinition id="Pc0_med" messageRef="Msg_Pc0" />
      </bpmn:startEvent>
      <bpmn:serviceTask id="Pc1" name="7. Проверить данные (BR-03…09) и версию объекта (ETag)">
        <bpmn:incoming>SF_27</bpmn:incoming>
        <bpmn:outgoing>SF_28</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="G2" name="Есть ошибки или конфликт версий?">
        <bpmn:incoming>SF_28</bpmn:incoming>
        <bpmn:outgoing>SF_29</bpmn:outgoing>
        <bpmn:outgoing>SF_30</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="PE" name="Коды ошибок или 409 отправлены отельеру">
        <bpmn:incoming>SF_29</bpmn:incoming>
        <bpmn:messageEventDefinition id="PE_med" messageRef="Msg_PE" />
      </bpmn:endEvent>
      <bpmn:serviceTask id="P6" name="8. Классифицировать изменение (BR-10)">
        <bpmn:incoming>SF_30</bpmn:incoming>
        <bpmn:outgoing>SF_31</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="G3" name="Значимое изменение?">
        <bpmn:incoming>SF_31</bpmn:incoming>
        <bpmn:outgoing>SF_32</bpmn:outgoing>
        <bpmn:outgoing>SF_33</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="P9a" name="9a. Автосогласовать по порогам (малое изменение)">
        <bpmn:incoming>SF_33</bpmn:incoming>
        <bpmn:outgoing>SF_34</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="P7" name="9. Создать задачу согласования (SLA 2 раб. ч)">
        <bpmn:incoming>SF_32</bpmn:incoming>
        <bpmn:outgoing>SF_42</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="M2" name="">
        <bpmn:incoming>SF_34</bpmn:incoming>
        <bpmn:incoming>SF_44</bpmn:incoming>
        <bpmn:outgoing>SF_35</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="P9" name="12–13. Создать версию (аудит), рассчитать цены и инвентарь">
        <bpmn:incoming>SF_35</bpmn:incoming>
        <bpmn:outgoing>SF_36</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:callActivity id="CA14" name="14. Публикация в каналы (схема 3)" calledElement="Proc_publication">
        <bpmn:incoming>SF_36</bpmn:incoming>
        <bpmn:outgoing>SF_37</bpmn:outgoing>
      </bpmn:callActivity>
      <bpmn:sendTask id="P12" name="15. Уведомить отельера и менеджера ТО о результате">
        <bpmn:incoming>SF_37</bpmn:incoming>
        <bpmn:outgoing>SF_38</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:serviceTask id="P13" name="16. Мониторинг: sell-through ≥ 80 %, релиз-даты">
        <bpmn:incoming>SF_38</bpmn:incoming>
        <bpmn:outgoing>SF_39</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="E2" name="Процесс завершён">
        <bpmn:incoming>SF_39</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:userTask id="M1" name="10–11. Принять решение по изменению">
        <bpmn:incoming>SF_42</bpmn:incoming>
        <bpmn:outgoing>SF_43</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:boundaryEvent id="MT" name="Истёк SLA (2 раб. ч)" attachedToRef="M1" cancelActivity="false">
        <bpmn:outgoing>SF_40</bpmn:outgoing>
        <bpmn:timerEventDefinition id="MT_ted" />
      </bpmn:boundaryEvent>
      <bpmn:exclusiveGateway id="Gm" name="Решение?">
        <bpmn:incoming>SF_43</bpmn:incoming>
        <bpmn:outgoing>SF_44</bpmn:outgoing>
        <bpmn:outgoing>SF_45</bpmn:outgoing>
        <bpmn:outgoing>SF_46</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="CQ" name="Сформулировать вопрос отельеру">
        <bpmn:incoming>SF_46</bpmn:incoming>
        <bpmn:outgoing>SF_48</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="CR" name="ALT-2. Указать причину отклонения (обязательное поле)">
        <bpmn:incoming>SF_45</bpmn:incoming>
        <bpmn:outgoing>SF_47</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="PS" name="Напомнить исполнителю; эскалировать руководителю (EXC-4)">
        <bpmn:incoming>SF_40</bpmn:incoming>
        <bpmn:outgoing>SF_41</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="PSE" name="Эскалация выполнена">
        <bpmn:incoming>SF_41</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="PRE" name="ALT-2. Версия «Отклонена»; отельер уведомлён">
        <bpmn:incoming>SF_47</bpmn:incoming>
        <bpmn:messageEventDefinition id="PRE_med" messageRef="Msg_PRE" />
      </bpmn:endEvent>
      <bpmn:endEvent id="PQE" name="Статус «Требуются уточнения»; отельер уведомлён">
        <bpmn:incoming>SF_48</bpmn:incoming>
        <bpmn:messageEventDefinition id="PQE_med" messageRef="Msg_PQE" />
      </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_21" name="" sourceRef="P0" targetRef="CA2" />
    <bpmn:sequenceFlow id="SF_22" name="" sourceRef="CA2" targetRef="G1" />
    <bpmn:sequenceFlow id="SF_23" name="нет" sourceRef="G1" targetRef="PB" />
    <bpmn:sequenceFlow id="SF_24" name="" sourceRef="PB" targetRef="PBE" />
    <bpmn:sequenceFlow id="SF_25" name="да" sourceRef="G1" targetRef="P3" />
    <bpmn:sequenceFlow id="SF_26" name="" sourceRef="P3" targetRef="E1" />
    <bpmn:sequenceFlow id="SF_27" name="" sourceRef="Pc0" targetRef="Pc1" />
    <bpmn:sequenceFlow id="SF_28" name="" sourceRef="Pc1" targetRef="G2" />
    <bpmn:sequenceFlow id="SF_29" name="да" sourceRef="G2" targetRef="PE" />
    <bpmn:sequenceFlow id="SF_30" name="нет" sourceRef="G2" targetRef="P6" />
    <bpmn:sequenceFlow id="SF_31" name="" sourceRef="P6" targetRef="G3" />
    <bpmn:sequenceFlow id="SF_32" name="да" sourceRef="G3" targetRef="P7" />
    <bpmn:sequenceFlow id="SF_33" name="нет" sourceRef="G3" targetRef="P9a" />
    <bpmn:sequenceFlow id="SF_34" name="" sourceRef="P9a" targetRef="M2" />
    <bpmn:sequenceFlow id="SF_35" name="" sourceRef="M2" targetRef="P9" />
    <bpmn:sequenceFlow id="SF_36" name="" sourceRef="P9" targetRef="CA14" />
    <bpmn:sequenceFlow id="SF_37" name="" sourceRef="CA14" targetRef="P12" />
    <bpmn:sequenceFlow id="SF_38" name="" sourceRef="P12" targetRef="P13" />
    <bpmn:sequenceFlow id="SF_39" name="" sourceRef="P13" targetRef="E2" />
    <bpmn:sequenceFlow id="SF_40" name="" sourceRef="MT" targetRef="PS" />
    <bpmn:sequenceFlow id="SF_41" name="" sourceRef="PS" targetRef="PSE" />
    <bpmn:sequenceFlow id="SF_42" name="" sourceRef="P7" targetRef="M1" />
    <bpmn:sequenceFlow id="SF_43" name="" sourceRef="M1" targetRef="Gm" />
    <bpmn:sequenceFlow id="SF_44" name="Согласовать" sourceRef="Gm" targetRef="M2" />
    <bpmn:sequenceFlow id="SF_45" name="Отклонить" sourceRef="Gm" targetRef="CR" />
    <bpmn:sequenceFlow id="SF_46" name="Запросить уточнение" sourceRef="Gm" targetRef="CQ" />
    <bpmn:sequenceFlow id="SF_47" name="" sourceRef="CR" targetRef="PRE" />
    <bpmn:sequenceFlow id="SF_48" name="" sourceRef="CQ" targetRef="PQE" />
    <bpmn:textAnnotation id="N3"><bpmn:text>Менеджер смотрит экран «было / стало», маржу и отклонение от BAR; при необходимости консультируется с Revenue Manager (BR-12).</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="N3_assoc" sourceRef="N3" targetRef="M1" />
    <bpmn:textAnnotation id="N1"><bpmn:text>Значимое изменение (BR-10): цена &gt; 10 % на любую ночь; остаток квоты ↓ &gt; 20 %; новый тариф; смена политики отмены; смена релиз-периода. Пороги настраивает Revenue Manager.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="N2"><bpmn:text>Автосогласование по таймауту не выполняется (финансовый риск). Невозврат решения менеджера эскалируется руководителю контрактинга (EXC-4).</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
