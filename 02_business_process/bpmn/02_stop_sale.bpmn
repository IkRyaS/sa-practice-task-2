<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_02_stop_sale" targetNamespace="http://bpmn.io/schema/bpmn" exporter="sa-practice-task-2" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_02_stop_sale">
    <bpmn:participant id="P_Hotel" name="Отель-партнёр (Отельер)" processRef="Proc_P_Hotel" />
    <bpmn:participant id="P_TO" name="Туроператор" processRef="Proc_P_TO" />
    <bpmn:messageFlow id="MF_18" name="" sourceRef="HA1" targetRef="Pa0" />
    <bpmn:messageFlow id="MF_19" name="" sourceRef="Pa2" targetRef="HC1" />
    <bpmn:messageFlow id="MF_20" name="" sourceRef="P15" targetRef="HC2" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_P_Hotel" name="Отель-партнёр (Отельер)" isExecutable="false">
      <bpmn:startEvent id="H0" name="Нужно срочно закрыть продажи (ремонт, авария, ЧС)">
        <bpmn:outgoing>SF_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sendTask id="HA1" name="A1. Выбрать даты, категории номеров и причину закрытия">
        <bpmn:incoming>SF_1</bpmn:incoming>
        <bpmn:outgoing>SF_2</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:intermediateCatchEvent id="HC1" name="Число затронутых броней получено">
        <bpmn:incoming>SF_2</bpmn:incoming>
        <bpmn:outgoing>SF_3</bpmn:outgoing>
        <bpmn:messageEventDefinition id="HC1_med" messageRef="Msg_HC1" />
      </bpmn:intermediateCatchEvent>
      <bpmn:intermediateCatchEvent id="HC2" name="Уведомление о закрытии получено">
        <bpmn:incoming>SF_3</bpmn:incoming>
        <bpmn:outgoing>SF_4</bpmn:outgoing>
        <bpmn:messageEventDefinition id="HC2_med" messageRef="Msg_HC2" />
      </bpmn:intermediateCatchEvent>
      <bpmn:endEvent id="HE" name="Продажи закрыты, брони сохранены">
        <bpmn:incoming>SF_4</bpmn:incoming>
      </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_1" name="" sourceRef="H0" targetRef="HA1" />
    <bpmn:sequenceFlow id="SF_2" name="" sourceRef="HA1" targetRef="HC1" />
    <bpmn:sequenceFlow id="SF_3" name="" sourceRef="HC1" targetRef="HC2" />
    <bpmn:sequenceFlow id="SF_4" name="" sourceRef="HC2" targetRef="HE" />
    <bpmn:textAnnotation id="N1"><bpmn:text>BR-11: stop-sale применяется немедленно и без согласования; действует только на новые продажи, подтверждённые брони не отменяются. Закрытие публикуется вне пакетирования (цель BG-2: ≤ 1 мин).</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmn:process id="Proc_P_TO" name="Туроператор" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P_TO">
      <bpmn:lane id="L_Sys" name="Платформа (система)">
        <bpmn:flowNodeRef>Pa0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Pa1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Pa2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Pa3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Mgr" name="Менеджер ТО">
        <bpmn:flowNodeRef>MT1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MT2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
      <bpmn:startEvent id="Pa0" name="Получен запрос на закрытие продаж">
        <bpmn:outgoing>SF_5</bpmn:outgoing>
        <bpmn:messageEventDefinition id="Pa0_med" messageRef="Msg_Pa0" />
      </bpmn:startEvent>
      <bpmn:serviceTask id="Pa1" name="A2. Определить действующие брони и тип квоты">
        <bpmn:incoming>SF_5</bpmn:incoming>
        <bpmn:outgoing>SF_6</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:intermediateThrowEvent id="Pa2" name="Число броней показано отельеру">
        <bpmn:incoming>SF_6</bpmn:incoming>
        <bpmn:outgoing>SF_7</bpmn:outgoing>
        <bpmn:messageEventDefinition id="Pa2_med" messageRef="Msg_Pa2" />
      </bpmn:intermediateThrowEvent>
      <bpmn:serviceTask id="Pa3" name="A3. Применить stop-sale: новая версия, аудит, высокий приоритет">
        <bpmn:incoming>SF_7</bpmn:incoming>
        <bpmn:outgoing>SF_8</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:parallelGateway id="F" name="">
        <bpmn:incoming>SF_8</bpmn:incoming>
        <bpmn:outgoing>SF_9</bpmn:outgoing>
        <bpmn:outgoing>SF_12</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:callActivity id="CA" name="14. Приоритетная публикация, вне пакетирования (схема 3)" calledElement="Proc_publication">
        <bpmn:incoming>SF_9</bpmn:incoming>
        <bpmn:outgoing>SF_10</bpmn:outgoing>
      </bpmn:callActivity>
      <bpmn:sendTask id="P15" name="15. Уведомить отельера и менеджера ТО">
        <bpmn:incoming>SF_10</bpmn:incoming>
        <bpmn:outgoing>SF_11</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:endEvent id="PE" name="Закрытие опубликовано">
        <bpmn:incoming>SF_11</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:inclusiveGateway id="Gor" name="Что требует внимания менеджера?" default="SF_15">
        <bpmn:incoming>SF_12</bpmn:incoming>
        <bpmn:outgoing>SF_13</bpmn:outgoing>
        <bpmn:outgoing>SF_14</bpmn:outgoing>
        <bpmn:outgoing>SF_15</bpmn:outgoing>
      </bpmn:inclusiveGateway>
      <bpmn:endEvent id="Ed" name="Задач менеджеру нет">
        <bpmn:incoming>SF_15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:userTask id="MT1" name="A4. Проверить размещение гостей">
        <bpmn:incoming>SF_13</bpmn:incoming>
        <bpmn:outgoing>SF_16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="E1" name="Размещение проверено">
        <bpmn:incoming>SF_16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:userTask id="MT2" name="A4. Оценить контрактные последствия (штрафы, компенсация)">
        <bpmn:incoming>SF_14</bpmn:incoming>
        <bpmn:outgoing>SF_17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="E2" name="Последствия оценены">
        <bpmn:incoming>SF_17</bpmn:incoming>
      </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_5" name="" sourceRef="Pa0" targetRef="Pa1" />
    <bpmn:sequenceFlow id="SF_6" name="" sourceRef="Pa1" targetRef="Pa2" />
    <bpmn:sequenceFlow id="SF_7" name="" sourceRef="Pa2" targetRef="Pa3" />
    <bpmn:sequenceFlow id="SF_8" name="" sourceRef="Pa3" targetRef="F" />
    <bpmn:sequenceFlow id="SF_9" name="" sourceRef="F" targetRef="CA" />
    <bpmn:sequenceFlow id="SF_10" name="" sourceRef="CA" targetRef="P15" />
    <bpmn:sequenceFlow id="SF_11" name="" sourceRef="P15" targetRef="PE" />
    <bpmn:sequenceFlow id="SF_12" name="" sourceRef="F" targetRef="Gor" />
    <bpmn:sequenceFlow id="SF_13" name="на закрытые даты есть брони" sourceRef="Gor" targetRef="MT1" />
    <bpmn:sequenceFlow id="SF_14" name="закрыта коммитментная квота" sourceRef="Gor" targetRef="MT2" />
    <bpmn:sequenceFlow id="SF_15" name="иначе" sourceRef="Gor" targetRef="Ed" />
    <bpmn:sequenceFlow id="SF_16" name="" sourceRef="MT1" targetRef="E1" />
    <bpmn:sequenceFlow id="SF_17" name="" sourceRef="MT2" targetRef="E2" />
  </bpmn:process>
  <bpmn:message id="Msg_HC1" name="Число затронутых броней" />
  <bpmn:message id="Msg_HC2" name="Уведомление о результате" />
  <bpmn:message id="Msg_Pa0" name="Запрос на закрытие продаж" />
  <bpmn:message id="Msg_Pa2" name="Число затронутых броней" />
