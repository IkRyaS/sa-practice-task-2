      <bpmndi:BPMNEdge id="SF_5_di" bpmnElement="SF_5"><di:waypoint x="456" y="380" /><di:waypoint x="487" y="380" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_6_di" bpmnElement="SF_6"><di:waypoint x="678" y="380" /><di:waypoint x="704" y="380" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_7_di" bpmnElement="SF_7"><di:waypoint x="816" y="380" /><di:waypoint x="847" y="380" /></bpmndi:BPMNEdge>
