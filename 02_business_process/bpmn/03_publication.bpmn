<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_03_publication" targetNamespace="http://bpmn.io/schema/bpmn" exporter="sa-practice-task-2" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_03_publication">
    <bpmn:participant id="P_Ch" name="Каналы продаж (B2C-сайт и приложение, B2B API агентств, OTA)" />
    <bpmn:participant id="P_TO" name="Туроператор" processRef="Proc_P_TO" />
    <bpmn:messageFlow id="MF_30" name="Пакет изменений" sourceRef="sT1" targetRef="P_Ch" />
    <bpmn:messageFlow id="MF_31" name="ACK" sourceRef="P_Ch" targetRef="sA" />
    <bpmn:messageFlow id="MF_32" name="Ошибка" sourceRef="P_Ch" targetRef="sB" />
    <bpmn:messageFlow id="MF_33" name="Stop-sale в канале" sourceRef="sT2" targetRef="P_Ch" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_P_TO" name="Туроператор" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P_TO">
      <bpmn:lane id="L_Sys" name="Платформа (система)">
        <bpmn:flowNodeRef>S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tb</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tpart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Trec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tfin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Adm" name="Администратор системы">
        <bpmn:flowNodeRef>TA</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
      <bpmn:startEvent id="S" name="Изменение готово к публикации">
        <bpmn:outgoing>SF_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="Gs" name="Это stop-sale?">
        <bpmn:incoming>SF_1</bpmn:incoming>
        <bpmn:outgoing>SF_2</bpmn:outgoing>
        <bpmn:outgoing>SF_3</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="Tp" name="Публиковать с высоким приоритетом, вне пакетирования">
        <bpmn:incoming>SF_2</bpmn:incoming>
        <bpmn:outgoing>SF_4</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Tb" name="Сгруппировать изменения «объект × канал» в пакет (окно 60 с)">
        <bpmn:incoming>SF_3</bpmn:incoming>
        <bpmn:outgoing>SF_5</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="Gm" name="">
        <bpmn:incoming>SF_4</bpmn:incoming>
        <bpmn:incoming>SF_5</bpmn:incoming>
        <bpmn:outgoing>SF_19</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:subProcess id="SP" name="Публикация в один канал (для каждого канала параллельно: B2C, B2B API, OTA)">
        <bpmn:incoming>SF_19</bpmn:incoming>
        <bpmn:outgoing>SF_20</bpmn:outgoing>
        <bpmn:multiInstanceLoopCharacteristics />
        <bpmn:startEvent id="sS" name="">
          <bpmn:outgoing>SF_6</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:sendTask id="sT1" name="Отправить пакет в канал">
          <bpmn:incoming>SF_6</bpmn:incoming>
          <bpmn:incoming>SF_17</bpmn:incoming>
          <bpmn:outgoing>SF_7</bpmn:outgoing>
        </bpmn:sendTask>
        <bpmn:eventBasedGateway id="sEG" name="" eventGatewayType="Exclusive">
          <bpmn:incoming>SF_7</bpmn:incoming>
          <bpmn:outgoing>SF_8</bpmn:outgoing>
          <bpmn:outgoing>SF_9</bpmn:outgoing>
          <bpmn:outgoing>SF_10</bpmn:outgoing>
        </bpmn:eventBasedGateway>
        <bpmn:intermediateCatchEvent id="sA" name="ACK получен">
          <bpmn:incoming>SF_8</bpmn:incoming>
          <bpmn:outgoing>SF_11</bpmn:outgoing>
          <bpmn:messageEventDefinition id="sA_med" messageRef="Msg_sA" />
        </bpmn:intermediateCatchEvent>
        <bpmn:intermediateCatchEvent id="sB" name="Ошибка канала (5xx, 429, формат)">
          <bpmn:incoming>SF_9</bpmn:incoming>
          <bpmn:outgoing>SF_12</bpmn:outgoing>
          <bpmn:messageEventDefinition id="sB_med" messageRef="Msg_sB" />
        </bpmn:intermediateCatchEvent>
        <bpmn:intermediateCatchEvent id="sC" name="Таймаут ответа канала">
          <bpmn:incoming>SF_10</bpmn:incoming>
          <bpmn:outgoing>SF_13</bpmn:outgoing>
          <bpmn:timerEventDefinition id="sC_ted" />
        </bpmn:intermediateCatchEvent>
        <bpmn:endEvent id="sEnd1" name="Канал обновлён">
          <bpmn:incoming>SF_11</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:exclusiveGateway id="sGx" name="">
          <bpmn:incoming>SF_12</bpmn:incoming>
          <bpmn:incoming>SF_13</bpmn:incoming>
          <bpmn:outgoing>SF_14</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:exclusiveGateway id="sG2" name="Попытки исчерпаны (4 из 4)?">
          <bpmn:incoming>SF_14</bpmn:incoming>
          <bpmn:outgoing>SF_15</bpmn:outgoing>
          <bpmn:outgoing>SF_16</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:intermediateCatchEvent id="sW" name="Пауза 1, 2, 4 или 8 мин">
          <bpmn:incoming>SF_16</bpmn:incoming>
          <bpmn:outgoing>SF_17</bpmn:outgoing>
          <bpmn:timerEventDefinition id="sW_ted" />
        </bpmn:intermediateCatchEvent>
        <bpmn:sendTask id="sT2" name="E2–E3. Канал → «Ошибка синхронизации»; fail-safe: закрыть продажи в канале">
          <bpmn:incoming>SF_15</bpmn:incoming>
          <bpmn:outgoing>SF_18</bpmn:outgoing>
        </bpmn:sendTask>
        <bpmn:endEvent id="sEnd2" name="Канал в fail-safe">
          <bpmn:incoming>SF_18</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="SF_6" name="" sourceRef="sS" targetRef="sT1" />
        <bpmn:sequenceFlow id="SF_7" name="" sourceRef="sT1" targetRef="sEG" />
        <bpmn:sequenceFlow id="SF_8" name="" sourceRef="sEG" targetRef="sA" />
        <bpmn:sequenceFlow id="SF_9" name="" sourceRef="sEG" targetRef="sB" />
        <bpmn:sequenceFlow id="SF_10" name="" sourceRef="sEG" targetRef="sC" />
        <bpmn:sequenceFlow id="SF_11" name="" sourceRef="sA" targetRef="sEnd1" />
        <bpmn:sequenceFlow id="SF_12" name="" sourceRef="sB" targetRef="sGx" />
        <bpmn:sequenceFlow id="SF_13" name="" sourceRef="sC" targetRef="sGx" />
        <bpmn:sequenceFlow id="SF_14" name="" sourceRef="sGx" targetRef="sG2" />
        <bpmn:sequenceFlow id="SF_15" name="да" sourceRef="sG2" targetRef="sT2" />
        <bpmn:sequenceFlow id="SF_16" name="нет" sourceRef="sG2" targetRef="sW" />
        <bpmn:sequenceFlow id="SF_17" name="" sourceRef="sW" targetRef="sT1" />
        <bpmn:sequenceFlow id="SF_18" name="" sourceRef="sT2" targetRef="sEnd2" />
      </bpmn:subProcess>
      <bpmn:exclusiveGateway id="Gr" name="Все каналы подтвердили ACK?">
        <bpmn:incoming>SF_20</bpmn:incoming>
        <bpmn:outgoing>SF_21</bpmn:outgoing>
        <bpmn:outgoing>SF_23</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="Tok" name="Установить статус «Опубликовано»">
        <bpmn:incoming>SF_21</bpmn:incoming>
        <bpmn:outgoing>SF_22</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="E1" name="Изменение опубликовано">
        <bpmn:incoming>SF_22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:serviceTask id="Tpart" name="E2, E4. Статус «Опубликовано частично»; создать инцидент, уведомить администратора и менеджера ТО">
        <bpmn:incoming>SF_23</bpmn:incoming>
        <bpmn:outgoing>SF_24</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="TA" name="E5. Диагностировать причину, устранить, запустить повторную публикацию">
        <bpmn:incoming>SF_24</bpmn:incoming>
        <bpmn:incoming>SF_29</bpmn:incoming>
        <bpmn:outgoing>SF_25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="Trec" name="E6. Сверить остатки с каналом (reconciliation)">
        <bpmn:incoming>SF_25</bpmn:incoming>
        <bpmn:outgoing>SF_26</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="Gc" name="Данные совпали, ACK получен?">
        <bpmn:incoming>SF_26</bpmn:incoming>
        <bpmn:outgoing>SF_27</bpmn:outgoing>
        <bpmn:outgoing>SF_29</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="Tfin" name="Снять fail-safe, закрыть инцидент, уведомить участников">
        <bpmn:incoming>SF_27</bpmn:incoming>
        <bpmn:outgoing>SF_28</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="E2" name="Инцидент закрыт">
        <bpmn:incoming>SF_28</bpmn:incoming>
      </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_1" name="" sourceRef="S" targetRef="Gs" />
    <bpmn:sequenceFlow id="SF_2" name="да" sourceRef="Gs" targetRef="Tp" />
    <bpmn:sequenceFlow id="SF_3" name="нет" sourceRef="Gs" targetRef="Tb" />
    <bpmn:sequenceFlow id="SF_4" name="" sourceRef="Tp" targetRef="Gm" />
    <bpmn:sequenceFlow id="SF_5" name="" sourceRef="Tb" targetRef="Gm" />
    <bpmn:sequenceFlow id="SF_19" name="" sourceRef="Gm" targetRef="SP" />
    <bpmn:sequenceFlow id="SF_20" name="" sourceRef="SP" targetRef="Gr" />
    <bpmn:sequenceFlow id="SF_21" name="да" sourceRef="Gr" targetRef="Tok" />
    <bpmn:sequenceFlow id="SF_22" name="" sourceRef="Tok" targetRef="E1" />
    <bpmn:sequenceFlow id="SF_23" name="нет" sourceRef="Gr" targetRef="Tpart" />
    <bpmn:sequenceFlow id="SF_24" name="" sourceRef="Tpart" targetRef="TA" />
    <bpmn:sequenceFlow id="SF_25" name="" sourceRef="TA" targetRef="Trec" />
    <bpmn:sequenceFlow id="SF_26" name="" sourceRef="Trec" targetRef="Gc" />
    <bpmn:sequenceFlow id="SF_27" name="да" sourceRef="Gc" targetRef="Tfin" />
    <bpmn:sequenceFlow id="SF_28" name="" sourceRef="Tfin" targetRef="E2" />
    <bpmn:sequenceFlow id="SF_29" name="нет" sourceRef="Gc" targetRef="TA" />
    <bpmn:textAnnotation id="N1"><bpmn:text>BR-13: изменения по паре «объект × канал» группируются в пакет с окном 60 с (stop-sale — вне пакетирования). Повторы при сбое через 1, 2, 4, 8 минут (4 попытки, всего 15 минут), идемпотентно. Канал без актуальных данных &gt; 15 минут закрывается (fail-safe), чтобы исключить продажу по устаревшему остатку (BG-3).</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="N2"><bpmn:text>Каналы публикуются независимо: сбой одного канала не блокирует остальные. Статус каждого канала хранится отдельно.</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmn:message id="Msg_sA" name="ACK канала" />
  <bpmn:message id="Msg_sB" name="Ошибка канала" />
  <bpmndi:BPMNDiagram id="Diagram_03_publication">
    <bpmndi:BPMNPlane id="Plane_03_publication" bpmnElement="Collab_03_publication">
