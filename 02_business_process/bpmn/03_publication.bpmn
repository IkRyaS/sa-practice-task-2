      <bpmndi:BPMNShape id="N2_di" bpmnElement="N2"><dc:Bounds x="1640" y="110" width="420" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SF_1_di" bpmnElement="SF_1"><di:waypoint x="208" y="380" /><di:waypoint x="267" y="380" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_2_di" bpmnElement="SF_2"><di:waypoint x="290" y="357" /><di:waypoint x="290" y="250" /><di:waypoint x="344" y="250" /><bpmndi:BPMNLabel><dc:Bounds x="296" y="300" width="20.3438" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
