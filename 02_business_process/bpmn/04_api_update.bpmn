<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_04_api_update" targetNamespace="http://bpmn.io/schema/bpmn" exporter="sa-practice-task-2" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_04_api_update">
    <bpmn:participant id="P_PMS" name="PMS / channel manager отеля" processRef="Proc_P_PMS" />
    <bpmn:participant id="P_Sys" name="Платформа туроператора (API)" processRef="Proc_P_Sys" />
    <bpmn:messageFlow id="MF_28" name="" sourceRef="Pt" targetRef="Pm0" />
    <bpmn:messageFlow id="MF_29" name="" sourceRef="Tresp" targetRef="Pr" />
    <bpmn:messageFlow id="MF_30" name="Сохранённый результат" sourceRef="Tr2" targetRef="Pr" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_P_PMS" name="PMS / channel manager отеля" isExecutable="false">
      <bpmn:startEvent id="Ps" name="Изменились квоты или тарифы в PMS">
        <bpmn:outgoing>SF_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sendTask id="Pt" name="Отправить пакет изменений с Idempotency-Key">
        <bpmn:incoming>SF_1</bpmn:incoming>
        <bpmn:outgoing>SF_2</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:receiveTask id="Pr" name="Принять статус по каждой строке">
        <bpmn:incoming>SF_2</bpmn:incoming>
        <bpmn:outgoing>SF_3</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:endEvent id="Pe" name="Результат обработан">
        <bpmn:incoming>SF_3</bpmn:incoming>
      </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_1" name="" sourceRef="Ps" targetRef="Pt" />
    <bpmn:sequenceFlow id="SF_2" name="" sourceRef="Pt" targetRef="Pr" />
    <bpmn:sequenceFlow id="SF_3" name="" sourceRef="Pr" targetRef="Pe" />
    <bpmn:textAnnotation id="N1"><bpmn:text>ALT-3: принцип «всё или ничего» действует на уровне строки (дата × категория × тариф): корректные строки принимаются, ошибочные отклоняются с кодом правила. Итоговый ответ содержит статус по каждой строке; ошибки — в формате application/problem+json (RFC 9457).</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="N2"><bpmn:text>EXC-2: устаревшая запись (не совпал ETag / If-Match) отклоняется с 409 Conflict; данные не затираются, в ответе — актуальная версия и различия.</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmn:process id="Proc_P_Sys" name="Платформа туроператора (API)" isExecutable="false">
      <bpmn:startEvent id="Pm0" name="Получен пакет изменений">
        <bpmn:outgoing>SF_4</bpmn:outgoing>
        <bpmn:messageEventDefinition id="Pm0_med" messageRef="Msg_Pm0" />
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="Gi" name="Idempotency-Key уже обработан?">
        <bpmn:incoming>SF_4</bpmn:incoming>
        <bpmn:outgoing>SF_5</bpmn:outgoing>
        <bpmn:outgoing>SF_22</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="Tf" name="Взять сохранённый результат">
        <bpmn:incoming>SF_5</bpmn:incoming>
        <bpmn:outgoing>SF_6</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sendTask id="Tr2" name="Вернуть сохранённый результат">
        <bpmn:incoming>SF_6</bpmn:incoming>
        <bpmn:outgoing>SF_7</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:endEvent id="Ed" name="Повтор обработан">
        <bpmn:incoming>SF_7</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:subProcess id="SP" name="Обработка строки пакета (дата × категория × тариф); строки независимы">
        <bpmn:incoming>SF_22</bpmn:incoming>
        <bpmn:outgoing>SF_23</bpmn:outgoing>
        <bpmn:multiInstanceLoopCharacteristics />
        <bpmn:startEvent id="sS" name="">
          <bpmn:outgoing>SF_8</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:serviceTask id="sV" name="Проверить версию объекта (ETag / If-Match)">
          <bpmn:incoming>SF_8</bpmn:incoming>
          <bpmn:outgoing>SF_9</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:exclusiveGateway id="sG1" name="Версия актуальна?">
          <bpmn:incoming>SF_9</bpmn:incoming>
          <bpmn:outgoing>SF_10</bpmn:outgoing>
          <bpmn:outgoing>SF_11</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:serviceTask id="sV2" name="7. Валидировать строку (BR-03…09)">
          <bpmn:incoming>SF_10</bpmn:incoming>
          <bpmn:outgoing>SF_12</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:exclusiveGateway id="sG2" name="Есть ошибки?">
          <bpmn:incoming>SF_12</bpmn:incoming>
          <bpmn:outgoing>SF_13</bpmn:outgoing>
          <bpmn:outgoing>SF_14</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:serviceTask id="sC" name="8. Классифицировать изменение (BR-10)">
          <bpmn:incoming>SF_13</bpmn:incoming>
          <bpmn:outgoing>SF_15</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:exclusiveGateway id="sG3" name="Значимое?">
          <bpmn:incoming>SF_15</bpmn:incoming>
          <bpmn:outgoing>SF_16</bpmn:outgoing>
          <bpmn:outgoing>SF_17</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:serviceTask id="sT" name="9. Создать задачу согласования">
          <bpmn:incoming>SF_16</bpmn:incoming>
          <bpmn:outgoing>SF_18</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:endEvent id="sEnd3" name="Строка принята: ждёт согласования">
          <bpmn:incoming>SF_18</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:serviceTask id="sR1" name="Отклонить строку: 409 Conflict, вернуть актуальную версию (EXC-2)">
          <bpmn:incoming>SF_11</bpmn:incoming>
          <bpmn:outgoing>SF_19</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:endEvent id="sEnd1" name="Строка отклонена">
          <bpmn:incoming>SF_19</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:serviceTask id="sR2" name="Отклонить строку: код правила BR (problem+json)">
          <bpmn:incoming>SF_14</bpmn:incoming>
          <bpmn:outgoing>SF_20</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:endEvent id="sEnd2" name="Строка отклонена">
          <bpmn:incoming>SF_20</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:serviceTask id="sA" name="9a. Автосогласовать по порогам">
          <bpmn:incoming>SF_17</bpmn:incoming>
          <bpmn:outgoing>SF_21</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:endEvent id="sEnd4" name="Строка принята">
          <bpmn:incoming>SF_21</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="SF_8" name="" sourceRef="sS" targetRef="sV" />
        <bpmn:sequenceFlow id="SF_9" name="" sourceRef="sV" targetRef="sG1" />
        <bpmn:sequenceFlow id="SF_10" name="да" sourceRef="sG1" targetRef="sV2" />
        <bpmn:sequenceFlow id="SF_11" name="нет" sourceRef="sG1" targetRef="sR1" />
        <bpmn:sequenceFlow id="SF_12" name="" sourceRef="sV2" targetRef="sG2" />
        <bpmn:sequenceFlow id="SF_13" name="нет" sourceRef="sG2" targetRef="sC" />
        <bpmn:sequenceFlow id="SF_14" name="да" sourceRef="sG2" targetRef="sR2" />
        <bpmn:sequenceFlow id="SF_15" name="" sourceRef="sC" targetRef="sG3" />
        <bpmn:sequenceFlow id="SF_16" name="да" sourceRef="sG3" targetRef="sT" />
        <bpmn:sequenceFlow id="SF_17" name="нет" sourceRef="sG3" targetRef="sA" />
        <bpmn:sequenceFlow id="SF_18" name="" sourceRef="sT" targetRef="sEnd3" />
        <bpmn:sequenceFlow id="SF_19" name="" sourceRef="sR1" targetRef="sEnd1" />
        <bpmn:sequenceFlow id="SF_20" name="" sourceRef="sR2" targetRef="sEnd2" />
        <bpmn:sequenceFlow id="SF_21" name="" sourceRef="sA" targetRef="sEnd4" />
      </bpmn:subProcess>
      <bpmn:sendTask id="Tresp" name="Сформировать ответ со статусом по каждой строке">
        <bpmn:incoming>SF_23</bpmn:incoming>
        <bpmn:outgoing>SF_24</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:exclusiveGateway id="Gp" name="Есть принятые строки?">
        <bpmn:incoming>SF_24</bpmn:incoming>
        <bpmn:outgoing>SF_25</bpmn:outgoing>
        <bpmn:outgoing>SF_27</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:callActivity id="CA" name="Шаги 10–16: согласование, версия, публикация (схемы 1, 3)" calledElement="Proc_main_process">
        <bpmn:incoming>SF_25</bpmn:incoming>
        <bpmn:outgoing>SF_26</bpmn:outgoing>
      </bpmn:callActivity>
      <bpmn:endEvent id="E1" name="Принятые строки опубликованы">
        <bpmn:incoming>SF_26</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="E2" name="Пакет полностью отклонён">
        <bpmn:incoming>SF_27</bpmn:incoming>
      </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_4" name="" sourceRef="Pm0" targetRef="Gi" />
    <bpmn:sequenceFlow id="SF_5" name="да" sourceRef="Gi" targetRef="Tf" />
    <bpmn:sequenceFlow id="SF_6" name="" sourceRef="Tf" targetRef="Tr2" />
    <bpmn:sequenceFlow id="SF_7" name="" sourceRef="Tr2" targetRef="Ed" />
    <bpmn:sequenceFlow id="SF_22" name="нет" sourceRef="Gi" targetRef="SP" />
    <bpmn:sequenceFlow id="SF_23" name="" sourceRef="SP" targetRef="Tresp" />
    <bpmn:sequenceFlow id="SF_24" name="" sourceRef="Tresp" targetRef="Gp" />
    <bpmn:sequenceFlow id="SF_25" name="да" sourceRef="Gp" targetRef="CA" />
    <bpmn:sequenceFlow id="SF_26" name="" sourceRef="CA" targetRef="E1" />
    <bpmn:sequenceFlow id="SF_27" name="нет" sourceRef="Gp" targetRef="E2" />
  </bpmn:process>
  <bpmn:message id="Msg_Pm0" name="Пакет изменений" />
